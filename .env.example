# ============================================================
# AgentKit 环境变量模板 —— 复制为 .env 后填入真实值
# 变量命名对齐 AgentKit CLI / VeADK 官方文档
# ============================================================

# ---------- 火山引擎账号凭证 (AK/SK) ----------
VOLCENGINE_ACCESS_KEY=
VOLCENGINE_SECRET_KEY=
VOLCENGINE_REGION=cn-beijing

# ---------- 火山方舟大模型 (Ark) ----------
MODEL_AGENT_API_KEY=
MODEL_AGENT_API_BASE=https://ark.cn-beijing.volces.com/api/v3/
MODEL_AGENT_NAME=doubao-seed-2-1-pro-260628
MODEL_AGENT_PROVIDER=openai

# ---------- 联网搜索 (veSearch 联网问答 Agent) ----------
TOOL_VESEARCH_API_KEY=
# 联网问答 Agent 的智能体 ID，控制台创建后填入：
# https://console.volcengine.com/ask-echo/my-agent
TOOL_VESEARCH_ENDPOINT=

# ---------- 火山引擎镜像仓库 ----------
IMAGE_REGISTRY=
IMAGE_NAMESPACE=

# ---------- GitHub 代码仓库 ----------
GITHUB_REPO=
