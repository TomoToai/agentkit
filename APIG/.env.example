RUNTIME_API_KEY=your-agentkit-runtime-api-key
# 存量业务 API 的认证密钥：部署前替换为随机强密钥，禁止提交真实值。
BUSINESS_API_KEY=replace-with-a-random-secret
CAMERA_HOST=127.0.0.1
CAMERA_PORT=8000
CAMERA_PUBLIC_BASE_URL=https://your-camera-demo.example.com

# AgentKit / 模型网关（填写控制台生成值）
MODEL_AGENT_NAME=your-primary-model-route
MODEL_AGENT_API_KEY=your-proxy-api-key
MODEL_ENDPOINT=https://your-model-gateway.example.com/api/v3
AGENTKIT_MCP_SERVER_URL=https://your-mcp-toolset.example.com/mcp
AGENTKIT_MCP_API_KEY=your-mcp-inbound-api-key

# 仅供 Web 后端调用云上 Agent Runtime；绝不下发给浏览器
AGENT_RUNTIME_URL=https://your-agent-runtime.example.com/invoke
AGENT_RUNTIME_API_KEY=your-agent-runtime-api-key
AGENT_RUNTIME_TIMEOUT_SECONDS=45
# 可选：指定企业网络所需的受信任 CA 证书包；默认使用 certifi。
AGENT_RUNTIME_CA_BUNDLE=

# 组织提供的 AgentKit SSO 登录地址，不要提交真实值
AGENTKIT_LOGIN_ADDRESS=https://your-agentkit-login.example.com
