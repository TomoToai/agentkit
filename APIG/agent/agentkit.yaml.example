launch_types:
  cloud:
    runtime_name: yingteng-camera-support
    runtime_auth_type: key_auth
    runtime_envs:
      MODEL_AGENT_NAME: camera-primary-route
      MODEL_AGENT_API_KEY: ${MODEL_GATEWAY_PROXY_KEY}
      MODEL_ENDPOINT: ${MODEL_GATEWAY_BASE_URL}
      AGENTKIT_MCP_SERVER_URL: ${MCP_TOOLSET_URL}
      AGENTKIT_MCP_API_KEY: ${MCP_TOOLSET_API_KEY}

